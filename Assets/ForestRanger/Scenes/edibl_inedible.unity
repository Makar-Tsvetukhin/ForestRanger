  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041C\u0430\u043B\u0438\u043D\u0430 \u2014 \u0440\u0430\u0441\u0442\u0435\u0442
    \u0432 \u043B\u0435\u0441\u0430\u0445 \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
    \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u0438\u043A\u0430\u0445. \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0430\u044F
    \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u0430\u044F \u044F\u0433\u043E\u0434\u0430,
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u0435\u0434\u0438, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043B\u0438\u0441\u044C \u043C\u0430\u043B\u0438\u043D\u043E\u0432\u044B\u0435
    \u043A\u043B\u043E\u043F\u044B. \u041E\u043D\u0438, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u043D\u0435 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0435, \u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
    \u0441\u0432\u043E\u0438\u043C \u0443\u0436\u0430\u0441\u043D\u044B\u043C \u0432\u043A\u0443\u0441\u043E\u043C
    \u0438\u0441\u043F\u043E\u0440\u0442\u044F\u0442."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
