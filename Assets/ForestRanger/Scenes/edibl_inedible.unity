  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u043F\u044F\u0442\u0430 \u043B\u043E\u0436\u043D\u044B\u0435 \u2014
    \u0442\u0435 \u0435\u0449\u0451 \u043F\u043E\u0434\u043B\u0435\u0446\u044B. \u041E\u0447\u0435\u043D\u044C
    \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435
    \u043E\u043F\u044F\u0442\u0430, \u043D\u043E \u0443 \u043B\u043E\u0436\u043D\u044B\u0445
    \u0431\u043E\u043B\u0435\u0435 \u044F\u0440\u043A\u0438\u0439 \u0446\u0432\u0435\u0442
    \u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043A\u043E\u043B\u044C\u0446\u043E
    \u043D\u0430 \u043D\u043E\u0436\u043A\u0435. \u041D\u0435 \u0441\u0442\u043E\u0438\u0442
    \u0434\u0430\u0436\u0435 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
    \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0442\u044C \u0432 \u043F\u0438\u0449\u0443
    \u2014 \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0442\u043E\u043A\u0441\u0438\u043D\u0430\u043C\u0438
    \u043A \u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443 \u043D\u0435 \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u0442."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
