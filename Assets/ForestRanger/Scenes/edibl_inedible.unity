  m_text: "\u0412\u043E\u0440\u043E\u043D\u0438\u0439 \u0433\u043B\u0430\u0437 \u2014
    \u043A\u0440\u0430\u0439\u043D\u0435 \u044F\u0434\u043E\u0432\u0438\u0442\u0430\u044F
    \u044F\u0433\u043E\u0434\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0436\u043D\u043E
    \u0441\u043F\u0443\u0442\u0430\u0442\u044C \u0441 \u0447\u0435\u0440\u043D\u0438\u043A\u043E\u0439
    \u0438\u043B\u0438 \u0433\u043E\u043B\u0443\u0431\u0438\u043A\u043E\u0439. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0435\u0441\u0442\u044C \u043E\u0434\u043D\u043E \u0432\u0430\u0436\u043D\u043E\u0435
    \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u2014 \u0432\u043E\u0440\u043E\u043D\u0438\u0439
    \u0433\u043B\u0430\u0437 \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0441\u0442\u0435\u0442
    \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u044F\u0433\u043E\u0434\u043E\u0439
    \u043D\u0430 \u043A\u0443\u0441\u0442\u0438\u043A\u0435."
