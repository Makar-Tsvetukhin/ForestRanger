  m_text: "\u0413\u043E\u043B\u0443\u0431\u0438\u043A\u0430 \u2014 \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u0430\u044F
    \u043B\u0435\u0441\u043D\u0430\u044F \u044F\u0433\u043E\u0434\u0430. \u041C\u043E\u0436\u043D\u043E
    \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
