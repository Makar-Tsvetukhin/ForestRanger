  m_text: "\u041B\u0430\u043D\u0434\u044B\u0448 \u2014 \u043A\u0440\u0430\u0441\u043D\u043E\u043A\u043D\u0438\u0436\u043D\u043E\u0435
    \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435, \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
    \u0435\u0433\u043E, \u043A\u0430\u043A \u0446\u0432\u0435\u0442\u044B, \u043D\u043E
    \u0438 \u0435\u0441\u0442\u044C \u0435\u0433\u043E \u044F\u0433\u043E\u0434\u044B.
    \u0423 \u043B\u0430\u043D\u0434\u044B\u0448\u0430 \u044F\u0434\u043E\u0432\u0438\u0442\u043E
    \u0432\u0441\u0435, \u0438 \u044F\u0433\u043E\u0434\u044B \u0432 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438."
