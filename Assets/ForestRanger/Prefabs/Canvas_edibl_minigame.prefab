  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0435\u0440\u0435\u0447\u043D\u044B\u0439 \u0433\u0440\u0438\u0431
    \u2014 \u0441\u0432\u043E\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439
    \u0434\u0440\u0443\u0436\u043E\u043A. \u0418\u043C\u0435\u0435\u0442 \u0433\u043E\u0440\u044C\u043A\u043E-\u043E\u0441\u0442\u0440\u044B\u0439
    \u0432\u043A\u0443\u0441 \u0438 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u0447\u0435\u0440\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0446, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u043C
    \u0438\u0437-\u0437\u0430 \u0432\u043A\u0443\u0441\u0430 (\u0442\u0430\u0440\u0435\u043B\u043A\u0443
    \u0442\u0430\u043A\u0438\u0445 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0441\u044A\u0435\u0441\u0442\u044C), \u043E\u0434\u043D\u0430\u043A\u043E \u0432
    \u043C\u0430\u043B\u044B\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430\u0445
    \u043C\u043E\u0436\u0435\u0442 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C
    \u0438\u0437\u044E\u043C\u0438\u043D\u043A\u0443 \u0431\u043B\u044E\u0434\u0443."
